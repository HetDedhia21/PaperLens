# Local Docker Postgres (host port 5433 avoids clashing with any local Postgres)
DATABASE_URL=postgresql+psycopg://paperlens:paperlens@localhost:5433/paperlens
# Neon later: DATABASE_URL = pooled string, DIRECT_DATABASE_URL = direct string (for Alembic)
DIRECT_DATABASE_URL=

MAX_PAPERS_PER_WORKSPACE=12